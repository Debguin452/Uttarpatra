{
  "name": "coaching-app",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:emulators": "firebase emulators:start --only auth,firestore",
    "build:web": "pnpm --filter web build",
    "deploy:api": "pnpm --filter api exec wrangler deploy",
    "deploy:web": "pnpm --filter web exec wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply coaching_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coaching_db --remote",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm vitest run firebase/tests\"",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "wrangler": "^3.80.0",
    "firebase-tools": "^13.21.0"
  }
}
